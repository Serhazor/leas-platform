# =============================================================================
#  Configuration — copy to .env.local (development) and set the same variables
#  in Vercel → Project → Settings → Environment Variables (production).
#  Never commit real secrets.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public URL of the site (no trailing slash). Used for SEO, sitemap and e-mail links.
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# --- Database (Supabase Postgres) --------------------------------------------
# Runtime connection: Supabase "Transaction pooler" URL (port 6543), recommended on Vercel.
# Supabase → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Migrations / seed: "Session pooler" (port 5432) or direct connection. Optional: falls back to DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Max connections per serverless instance (keep low with the pooler).
DATABASE_POOL_MAX=5

# --- Media storage (Supabase Storage) -----------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret service key — server side only, never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# "local" stores uploads in /public/uploads (development only, ignored on Vercel).
# STORAGE_DRIVER=local

# --- Security -----------------------------------------------------------------
# Random secret (at least 32 characters) used to hash IP addresses for login throttling.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# Secret protecting the daily data-retention job (/api/cron/nettoyage). Vercel sends it automatically.
CRON_SECRET=

# --- Transactional e-mails (Resend) -------------------------------------------
# Without a key, e-mails are printed in the server logs instead of being sent.
RESEND_API_KEY=
# Sender address on a domain verified in Resend. The display name comes from the admin settings.
EMAIL_FROM=Leas <notifications@votre-domaine.fr>

# --- Seed only ------------------------------------------------------------------
# Optional: initial address receiving booking / contact notifications.
ADMIN_NOTIFICATION_EMAIL=
